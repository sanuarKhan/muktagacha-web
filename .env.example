# ===========================================================================
# MUKTAGACHA — FRONTEND environment variables
# ===========================================================================
# Where to put these: Vercel dashboard
#   Vercel -> your project -> Settings -> Environment Variables
#   Add each one, tick "Production" (and "Preview" if you want previews to
#   work too), then go to Deployments and REDEPLOY.
#
# *** THE MOST IMPORTANT THING TO KNOW ***
# Anything starting with NEXT_PUBLIC_ is baked into the website when it is
# BUILT — it is not read while the site is running. So changing a value in
# the Vercel dashboard does NOTHING until you redeploy. If you change one of
# these and the site behaves the same, that's why: you need a fresh deploy.
#
# Second thing: NEXT_PUBLIC_ values are visible to anyone who views your
# site's source. That is expected and fine for the values below (a web
# address and your public payment numbers) — but never put a password, API
# secret, or database URL in a NEXT_PUBLIC_ variable.
# ===========================================================================


# ---------------------------------------------------------------------------
# 1. REQUIRED — the site cannot talk to your backend without this
# ---------------------------------------------------------------------------

# The address of your backend server. Used for BOTH normal page data and the
# live chat connection.
# >>> YOU MUST FILL THIS IN with your real backend URL. <<<
#
# Rules:
#   - Include https://
#   - NO trailing slash   (https://api.example.com/  <- WRONG)
#
# If this is wrong, every page shows errors or empty data, and login fails.
# Whatever you put here must ALSO be allowed by CORS_ORIGIN on the backend —
# the two settings are a matched pair and both have to be right.
NEXT_PUBLIC_API_URL=https://your-backend-name.onrender.com


# ---------------------------------------------------------------------------
# 2. STRONGLY RECOMMENDED — a page shows broken text to customers without it
# ---------------------------------------------------------------------------

# Your platform's own bKash and Nagad numbers. These are shown to buyers on
# the Wallet top-up page, telling them where to send money.
#
# If you leave these blank, buyers literally see the words
# "(not configured yet)" where the payment number should be — so the wallet
# top-up feature is unusable until you set them.
#
# >>> FILL IN with the real numbers you want customers to pay into. <<<
# These are shown publicly to customers, which is intended.
NEXT_PUBLIC_PLATFORM_BKASH_NUMBER=01XXXXXXXXX
NEXT_PUBLIC_PLATFORM_NAGAD_NUMBER=01XXXXXXXXX


# ===========================================================================
# HOW THE TWO HALVES CONNECT — the #1 source of confusion
# ===========================================================================
#
#   FRONTEND (Vercel)                     BACKEND (Render)
#   -----------------                     ----------------
#   NEXT_PUBLIC_API_URL  ───points at──►  the backend's address
#   the frontend's address  ◄──allowed by─  CORS_ORIGIN
#
# Both arrows must be correct. Getting one right and the other wrong is
# exactly what produces the "CORS policy" error you saw.
#
# Worked example — if your real addresses are:
#     frontend: https://muktagacha.vercel.app
#     backend:  https://muktagacha-backend.onrender.com
#
# then set, on Vercel:
#     NEXT_PUBLIC_API_URL=https://muktagacha-backend.onrender.com
# and on Render:
#     CORS_ORIGIN=https://muktagacha.vercel.app
#
# Notice they point AT EACH OTHER — not at themselves. Mixing this up is the
# single most common mistake.
#
# Then redeploy BOTH.
# ===========================================================================
